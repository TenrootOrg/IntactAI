
# Generated client installers
client_installers/

# Backup files
*.backup

# Data directory - exclude actual data but keep directory structure
data/*.json
data/*.json.migrated
data/intact.db
data/intact.db-shm
data/intact.db-wal
# Vendor CLI installed at runtime for subscription LLM providers (~350 MB of
# native binary + unpacked release). Fetched on demand by Settings -> Agentic;
# never part of the source tree. Credentials never live here — they are kept in
# the `secrets` table and materialised to tmpfs per call.
data/agentic_cli/
data/reports/
data/scheduler_jobs.db

# NVD CVE lookup cache populated at runtime by services/cve_scan/nvd.py.
# 100+ MB; expensive to rebuild but pure cache, not source.
data/cve_cache/

# Velociraptor working dir, host-mounted (was a named volume) so the configs
# survive container deletion + are editable/backuppable. server.config.yaml
# holds the CA private key — never commit. Keep the dir (.gitkeep) so the
# bind-mount target exists in a fresh checkout.
data/velociraptor/*
!data/velociraptor/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo

# Log files
*.log
scripts/prepare_offline_*.log
scripts/repair_*.log
install_*.log

# IRIS secrets (generated on install)
modules/iris/secrets/*
!modules/iris/secrets/.gitkeep

# Portainer admin password file (generated on install)
modules/portainer/secrets/*
!modules/portainer/secrets/.gitkeep

# VolWeb admin password file (generated on install)
modules/volweb/secrets/*
!modules/volweb/secrets/.gitkeep

# Certificates (generated on install)
modules/iris/config/certificates/rootCA/*
modules/iris/config/certificates/web_certificates/*
!modules/iris/config/certificates/rootCA/.gitkeep
!modules/iris/config/certificates/web_certificates/.gitkeep

# Nginx SSL (generated on install)
modules/nginx/ssl/*
!modules/nginx/ssl/.gitkeep

# Downloaded tools (large binaries)
data/tools/

# Downloaded Velociraptor binaries (used for offline collectors)
modules/nginx/html/downloads/

# Frontend database
data/frontend_data.db

# Upgrade packages (created by scripts/create-upgrade-package.sh)
intact-upgrade-*.tar.gz

# Velociraptor binary + shipped artifact definitions (gitignored — large files)
modules/velociraptor/velociraptor/

# Azure app-auth cert (generated at install)
data/azure_cert.pfx
data/azure_cert_public.pem

# Azure scan results (runtime data)
data/azure_runs/

# AWS scan results (runtime data)
data/aws_runs/

# DFIQ data — auto-cloned from google/dfiq at install time
# (see lib/modules.sh). Treated as runtime data, not source.
modules/timesketch/config/dfiq/

# DFIR-O365RC temp output
data/tmp/

# Operator runtime data — report/run downloads + upgrade package staging. These are
# docker-volume-backed at runtime (see modules/backend/docker-compose.yaml); ignored
# here so an operator-side copy never lands in git.
data/downloads/
data/upgrade_packages/

# Misc artefacts that must never be committed
*.bak
*.corrupt

# ============================================================================
# Secrets — belt-and-suspenders
# ============================================================================
# The list above already covers known sensitive paths individually. These
# blanket rules catch the next "I'll just drop a cert here" mistake before
# it reaches a commit. Plus a hard exclusion for rendered templates whose
# .template files are tracked but the substituted output is not.

# Private keys / cert bundles anywhere in the tree
*.pfx
*.p12
*.key
# .pem is more nuanced — IRIS ships a directory of dev PEMs that are
# generated on install; the existing per-path rules above already cover
# those. A blanket *.pem rule would conflict, so we don't add one here.
# If you drop a new .pem somewhere, add it explicitly.

# Env files at the repo root (developer-local). The per-module
# `.env` files (modules/<mod>/.env) are install-time defaults the
# operator rotates per-host — they're tracked on purpose with
# placeholder passwords (see docs/SECRETS.md). Pre-commit gitleaks
# is the actual defense against secrets in tracked files.
.env
.env.*
!.env.example
!modules/*/.env

# VolWeb is the exception to the per-module .env rule: its .env is
# RENDERED at install time from `.env.template` with per-install
# secrets (DJANGO_SECRET, POSTGRES_PASSWORD = `openssl rand` values).
# Tracking it would either ship those random secrets or revert them
# on every pull. Keep the template tracked; the rendered file is
# operator-machine-only.
modules/volweb/.env
!modules/volweb/.env.template

# Rendered configs — the .template files stay tracked, the rendered
# output (which holds the live API key) does not.
modules/timesketch/config/timesketch.conf
modules/timesketch/config/timesketch_legacy.conf

# Local-developer files generated by `pre-commit install`
.pre-commit-cache/

# Tailwind build environment for the nginx module. The built stylesheet
# `modules/nginx/html/css/tailwind.css` IS committed and served directly;
# the npm-side install artifacts are not (the build runs inside a
# node:20-alpine container via `modules/nginx/build-tailwind.sh`).
modules/nginx/node_modules/
modules/nginx/package.json
modules/nginx/package-lock.json

# Timesketch upgrade DB dumps + migrations cache (created at upgrade time,
# never committed — operators prune them manually)
/backups/

# Skill download cache — seeded from services/agentic/skills/ at runtime
# by services/skills_download_service.py. Source-of-truth lives in
# services/agentic/skills/ (committed); this dir is operator state.
/data/skills/

# Velociraptor build-context staging dir — populated at install/upgrade
# time by `stage_velociraptor_client_binaries` in lib/docker.sh and the
# Python equivalent in services/upgrade/velociraptor.py. Binaries are
# downloaded from upstream, not source-controlled.
/modules/velociraptor/clients/

# Belt-and-suspenders: never track SQLite DB files (defense-in-depth
# after the data/mssp.db blob leak — see git filter-repo run on 2026-06-07)
data/*.db
data/*.db-shm
data/*.db-wal

# Fused-graph sidecar files (runtime, per-case)
data/fusion_graphs/

# Wave F "the flip" (Full-mode backend image): operator-local dev override that
# re-adds live-reload code bind-mounts on a dev box. See
# modules/backend/docker-compose.override.yaml.example for the template.
/modules/backend/docker-compose.override.yaml
