# Session/Cookie settings for HTTP access
SESSION_COOKIE_SECURE = False
SESSION_COOKIE_HTTPONLY = True
SESSION_COOKIE_SAMESITE = 'Lax'
SESSION_COOKIE_NAME = 'timesketch_session'
SESSION_COOKIE_PATH = '/'
REMEMBER_COOKIE_SECURE = False
REMEMBER_COOKIE_HTTPONLY = True
REMEMBER_COOKIE_SAMESITE = 'Lax'
# 1 week (604800s). Bumped from 3600 (1h) so service-to-service automation
# (the backend's timesketch_api_client uses session cookies — TS upstream
# doesn't ship API tokens) doesn't lose its session mid-poll. Bounded so
# stolen cookies can't be replayed indefinitely.
REMEMBER_COOKIE_DURATION = 604800
PERMANENT_SESSION_LIFETIME = 604800

# DFIQ - enabled post-install via db migration in install.sh
DFIQ_ENABLED = True
DFIQ_PATH = '/etc/timesketch/dfiq/'

