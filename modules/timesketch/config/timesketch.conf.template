# TimeSketch Configuration
# Based on official TimeSketch config

DEBUG = False
ENABLE_PROFILING = False

# Key for signing cookies and for CSRF protection. The literal value
# here is a placeholder — install.sh's lib/modules.sh:render replaces it
# with `openssl rand -hex 32` when the template is copied to
# timesketch.conf. NEVER edit the rendered conf to use a static value;
# every install MUST have a unique SECRET_KEY or anyone with this repo
# can forge session cookies for any IntactAI deployment.
SECRET_KEY = '__SECRET_KEY__'

# Database
SQLALCHEMY_DATABASE_URI = 'postgresql://timesketch:timesketch@intact_timesketch_postgres/timesketch'
SQLALCHEMY_ENGINE_OPTIONS = {}

# OpenSearch - using official format
OPENSEARCH_HOST = 'intact_timesketch_opensearch'
