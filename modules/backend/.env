# =============================================================================
# Backend container env — install-time defaults
# =============================================================================
#
# This file is tracked in git on purpose so that a fresh `git clone &&
# ./install.sh` can bring the backend container up without manual setup.
# All values below are DEFAULTS, not secrets:
#
#   * Service hosts/ports are container-internal DNS names (intact_*).
#   * Versions are pinned for reproducibility.
#   * `TIMESKETCH_PASS=123123` is the install-time placeholder shared
#     with `config.yaml`. It MUST be rotated post-install — change it
#     in `config.yaml` and re-run `./install.sh`, or update both this
#     file and the running TimeSketch user via `tsctl set-password`.
#
# Real per-host secrets (LLM API keys, Azure tenant credentials) never
# live in this file — they go into the runtime config DB
# (`data/frontend_data.db`) via the Settings page in the dashboard. See
# `docs/SECRETS.md` for the full handling pattern.
# =============================================================================

# Elasticsearch
ELASTICSEARCH_HOST=intact_elasticsearch
ELASTICSEARCH_PORT=9200

# TimeSketch — TIMESKETCH_PASS is a placeholder; rotate post-install.
TIMESKETCH_HOST=http://intact_timesketch_web:5000
TIMESKETCH_USER=tenroot
TIMESKETCH_PASS=123123

# Plaso (log2timeline) version pin
PLASO_VERSION=20260119

# AWS Prowler image version (posture scans). Pinned tag.
PROWLER_VERSION=5.28.1
# Azure DFIR-O365RC image version (Unified Audit Log). Upstream only ships
# ':latest', so this tracks latest.
DFIR_O365RC_VERSION=latest

# Velociraptor API client config (read-only, mounted into the container)
VELO_CONFIG_PATH=/app/config/velociraptor/api.config.yaml

# Main config file path inside the container
CONFIG_PATH=/app/config.yaml

# Backend runtime image tag. Full-mode: the backend runs code baked into
# intact-backend:<this value>, never from host bind-mounts. The compose file
# declares this REQUIRED (no default) so a box can never silently boot a stale
# image. install.sh restamps it from config.yaml versions.backend; this shipped
# value keeps a fresh clone bootable on its own.
BACKEND_VERSION=intact-20260615
