VELOCIRAPTOR_VERSION=0.77.1
VELOCIRAPTOR_TAG=0.77
VELOX_USER=tenroot
VELOX_PASSWORD=123123
VELOX_ROLE=administrator
VELOX_USER_2=api
VELOX_PASSWORD_2=123123
VELOX_ROLE_2=api,administrator

# Hostname configuration - set to server IP or domain name
VELOX_FRONTEND_HOSTNAME=192.168.120.10
VELOX_PUBLIC_IP=192.168.120.10
VELOX_SERVER_URL=https://192.168.120.10:8000/

# Elasticsearch credentials (mirrors modules/elk/.env) — consumed by the
# Custom.Elastic.Flows.Upload server artifact via environ() so it can
# authenticate to Elasticsearch, which now requires auth (xpack.security).
ELASTIC_USER=elastic
ELASTIC_PASSWORD=123123
