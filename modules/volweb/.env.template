# VolWeb container env — rendered at install time by lib/modules.sh:deploy_volweb
#
# Tracked WITHOUT real secrets — install.sh fills in:
#   * VOLWEB_DJANGO_SECRET  — `openssl rand -hex 32` per install
#                             (mirrors timesketch.conf SECRET_KEY pattern)
#   * VOLWEB_POSTGRES_PASSWORD — `openssl rand -hex 24` per install
#   * VOLWEB_CSRF_TRUSTED_ORIGINS — derived from config.yaml:domain
#
# Version pins come from config.yaml versions.volweb_* — install.sh
# substitutes them so a fresh clone is reproducible.

# Image versions (pinned by install.sh from config.yaml)
VOLWEB_BACKEND_VERSION=__VOLWEB_BACKEND_VERSION__
VOLWEB_FRONTEND_VERSION=__VOLWEB_FRONTEND_VERSION__
VOLWEB_POSTGRES_VERSION=__VOLWEB_POSTGRES_VERSION__
VOLWEB_REDIS_VERSION=__VOLWEB_REDIS_VERSION__

# Postgres (VolWeb's own — separate from intact_timesketch_postgres)
VOLWEB_POSTGRES_USER=volweb
VOLWEB_POSTGRES_PASSWORD=__VOLWEB_POSTGRES_PASSWORD__
VOLWEB_POSTGRES_DB=volweb

# Django SECRET_KEY for session signing + CSRF tokens.
# REQUIRED to be unique per install — anyone with this can forge
# session cookies for any IntactAI deployment that ships it static.
# `lib/modules.sh:deploy_volweb` renders this with `openssl rand -hex 32`.
VOLWEB_DJANGO_SECRET=__VOLWEB_DJANGO_SECRET__

# CSRF trusted origins — comma-separated. Derived from config.yaml:domain
# (e.g. https://192.168.120.10 + http://intact_nginx:80 for in-tree proxy).
VOLWEB_CSRF_TRUSTED_ORIGINS=__VOLWEB_CSRF_TRUSTED_ORIGINS__

# Resource caps
VOLWEB_YARASCAN_CPU_LIMIT=1.0
